SHARED_URL=http://localhost:9000/remoteEntry.js

# Catatan: nama app di UI ("Portal MFE") di-hardcode di kode (bukan env),
# karena NEXT_PUBLIC_* build-time dan nama app statis.

# ============================================
# DEVELOPMENT ONLY (tidak dipakai di prod)
# ============================================

# Akun demo lokal mengikuti alur login + OTP yang sama dengan aplikasi.
LOCAL_DEMO_AUTH=true
LOCAL_DEMO_ADMIN_USERNAME=admin
LOCAL_DEMO_ADMIN_PASSWORD=Admin123!
LOCAL_DEMO_ADMIN_OTP=194263
LOCAL_DEMO_KEMENKES_USERNAME=kemenkes
LOCAL_DEMO_KEMENKES_PASSWORD=Kemenkes123!
LOCAL_DEMO_KEMENKES_OTP=583917
LOCAL_DEMO_KEMENKEU_USERNAME=kemenkeu
