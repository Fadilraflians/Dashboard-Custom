# ============================================
# Template Shell - contoh .env (salin ke .env, isi nilainya)
# Satu file .env dipakai untuk dev & prod. Yang membedakan hanya command
# (NODE_ENV), bukan file-nya.
#
#   dev  : pnpm dev     (NODE_ENV=development, hot reload)
#   prod : pnpm build && pnpm start   (NODE_ENV=production)
# ============================================

# ============================================
# PRODUCTION (wajib diisi)
# ============================================

SERVER_PORT=3000
AUTH_COOKIE_NAME=shell_session
# Idle (sliding) 15 menit + absolute (hard cap, no extend) 60 menit.
SESSION_IDLE_TTL=900
SESSION_ABSOLUTE_TTL=3600
# Secure cookie flag: false untuk HTTP, true untuk HTTPS.
COOKIE_SECURE=false

# Base URL backend API gateway (auth: login/verify-otp/totp)
API_BASE_URL=http://ifp-dev-api-gateway-ifp.apps.dev-digi.ocp.hq.bni.co.id

# ── Sumber autentikasi (RBAC B1-penuh) ──
# AUTH_SOURCE=ifp  -> login lewat gateway IFP (default, perilaku lama).
# AUTH_SOURCE=db   -> login diverifikasi ke skema Oracle AUTH_SYSTEM.MASTER_USER
#                     (username + password bcrypt + OTP/TOTP). Semua akun wajib OTP.
# Flag ini saklar: pindah kembali ke 'ifp' untuk rollback instan tanpa ubah kode.
AUTH_SOURCE=ifp
# Koneksi ke skema AUTH_SYSTEM (dipakai hanya saat AUTH_SOURCE=db).
AUTH_DB_USER=AUTH_SYSTEM
AUTH_DB_PASS=replace-with-auth-system-password
AUTH_DB_HOST=localhost
AUTH_DB_PORT=1522
AUTH_DB_SERVICE=DASHBOARDDB
# Alternatif: isi connect string penuh (mengabaikan HOST/PORT/SERVICE di atas).
# AUTH_DB_CONNECT_STRING=localhost:1522/DASHBOARDDB

# RSA private key (PKCS8 PEM, satu baris pakai \n) untuk lapis enkripsi
# FE<->server. Generate sepasang baru per environment:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log(privateKey.replace(/\r?\n/g,'\\n'))"
# Public key diturunkan dari private ini dan disajikan via /api/crypto/public-key.
FE_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...isi private key PKCS8...\n-----END PRIVATE KEY-----"

REDIS_HOST=192.168.188.231
REDIS_PORT=6380
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_KEY_PREFIX=test-micro-fe:

# ─── MFE per MENU (map by menuCode) ───
# Satu blok per menu, prefix MFE_<menuCode>_ (menuCode dari API menus).
# SCOPE = webpack `name` MFE (unik); URL = remoteEntry.js; BFF_URL = port BFF MFE.
# MODULE default ke MFE_DEFAULT_MODULE; override per-menu bila perlu.
# SECTION tidak punya remote -> tanpa env.
MFE_DEFAULT_MODULE=./mount

# Hanya menu LEAF (punya routePath) yang punya remote. SECTION & menu
# ber-child (expandable) tanpa env. Semua selain Dashboard masih placeholder.

# --- Utama ---
MFE_BOK_DASHBOARD_SCOPE=dashboardBok
MFE_BOK_DASHBOARD_URL=http://localhost:3001/remoteEntry.js
MFE_BOK_DASHBOARD_BFF_URL=http://localhost:3101

MFE_BOK_CUSTOM_DASHBOARD_SCOPE=customDashboard
MFE_BOK_CUSTOM_DASHBOARD_URL=http://localhost:3025/remoteEntry.js

