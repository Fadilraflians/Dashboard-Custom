LOCAL_DEMO_KEMENKEU_OTP=762415

# Private server-to-server authentication for the AIGovtech API.
# Set the same random value in AiGovtech/.env. Never expose as NEXT_PUBLIC_*.
AIGOVTECH_GATEWAY_SECRET=replace-with-shared-random-secret

LOG_LEVEL=info
