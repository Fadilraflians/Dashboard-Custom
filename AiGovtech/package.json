{
  "name": "ai-govtech-chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently \"pnpm dev:api\" \"pnpm dev:client\"",
    "dev:client": "cross-env NODE_ENV=development webpack serve --mode development",
    "dev:api": "cross-env NODE_ENV=development node src/api/index.cjs",
    "build": "cross-env NODE_ENV=production webpack --mode production",
    "start:api": "cross-env NODE_ENV=production node src/api/index.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.21.0",
    "oracledb": "^26.0.0",
    "otplib": "12.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.7.2",
    "webpack": "^5.105.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  }
}