OPTIONS (SKIP=1, ERRORS=0)
LOAD DATA
CHARACTERSET AL32UTF8
INFILE '/tmp/fashion_sales.csv'
APPEND
INTO TABLE FASHION_SALES
FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"'
TRAILING NULLCOLS
(
  ID INTEGER EXTERNAL,
  ORDER_ID CHAR(30),
  ORDER_DATE TIMESTAMP "YYYY-MM-DD HH24:MI:SS",
  CUSTOMER_NAME CHAR(150),
  CITY CHAR(150),
  PRODUCT_NAME CHAR(150),
  UNIT_PRICE DECIMAL EXTERNAL,
  QUANTITY INTEGER EXTERNAL,
  DISCOUNT_PERCENT DECIMAL EXTERNAL,
  SUBTOTAL DECIMAL EXTERNAL,
  DISCOUNT_AMOUNT DECIMAL EXTERNAL,
  TOTAL_SALES DECIMAL EXTERNAL,
  SHIPPING_FEE DECIMAL EXTERNAL,
  GRAND_TOTAL DECIMAL EXTERNAL,
  PAYMENT_METHOD CHAR(100),
  ORDER_STATUS CHAR(40),
  PLATFORM CHAR(150),
  CUSTOMER_RATING DECIMAL EXTERNAL,
  PRODUCT_SIZE CHAR(20),
  MATERIAL CHAR(100),
  GENDER CHAR(30)
)
