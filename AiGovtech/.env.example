# Oracle tenant connections (set real credentials only in ignored .env files).
DB_FASHION_USER=FASHION_APP
DB_FASHION_PASS=replace-with-local-secret
DB_FASHION_HOST=localhost
DB_FASHION_PORT=1522
DB_FASHION_SERVICE=DASHBOARDDB

DB_KEMENKEU_USER=KEMENKEUDB
DB_KEMENKEU_PASS=replace-with-local-secret
DB_KEMENKEU_HOST=localhost
DB_KEMENKEU_PORT=1522
DB_KEMENKEU_SERVICE=DASHBOARDDB

# Must match shell/.env.local. The gateway adds it only after resolving the
# authenticated user's company from the server-side session.
AIGOVTECH_GATEWAY_SECRET=replace-with-shared-random-secret

# Existing AI provider settings (configure according to your local provider).
AI_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
